# OpenClaw Railway Template — Full-Stack Edition
# Copy this file to .env and fill in the values you need.
# All API keys are optional — tools only install when their key is set.

# --- Required ---
# Password for /onboard, /lite, /tui, /tools pages
SETUP_PASSWORD=

# --- OpenClaw Core ---
# Pin specific OpenClaw version (e.g. 2026.3.7). Leave empty for latest stable.
OPENCLAW_VERSION=2026.3.7
# OpenClaw config and state directory
OPENCLAW_STATE_DIR=/data/.openclaw
# OpenClaw workspace directory
OPENCLAW_WORKSPACE_DIR=/data/workspace
# Internal gateway auth token (auto-generated if not set)
# OPENCLAW_GATEWAY_TOKEN=
# Wrapper HTTP port (Railway overrides this)
# PORT=8080

# --- AI Provider API Keys ---
# Anthropic — enables Claude Code CLI + Claude models
ANTHROPIC_API_KEY=
# OpenAI — enables OpenAI Codex CLI + GPT models
OPENAI_API_KEY=
# Google Gemini — enables Gemini CLI + Gemini models
GEMINI_API_KEY=
# OpenRouter — enables all OpenRouter models
OPENROUTER_API_KEY=

# --- Messaging Channels ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Discord bot token
DISCORD_BOT_TOKEN=
# Slack bot token (xoxb-...)
SLACK_BOT_TOKEN=
# Slack app token (xapp-...)
SLACK_APP_TOKEN=
# Signal phone number (E.164 format: +1234567890)
SIGNAL_PHONE_NUMBER=

# --- Google Workspace ---
# Base64-encoded Google OAuth credentials.json
# Enables Gmail, Calendar, Drive, Contacts via gog skill
# Generate: base64 -i credentials.json | tr -d '\n'
GOOGLE_OAUTH_CREDENTIALS_B64=

# --- MCP Servers ---
# Brave Search API key — enables Brave Search MCP server
BRAVE_SEARCH_API_KEY=
# GitHub Personal Access Token (repo scope) — enables GitHub MCP server
GITHUB_TOKEN=
# Comma-separated extra MCP packages (e.g. context7,@myorg/custom-mcp)
MCP_SERVERS=

# --- Features ---
# Enable web terminal at /tui
ENABLE_WEB_TUI=true
